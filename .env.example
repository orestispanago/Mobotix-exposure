# Copy to .env and set the real values there, not in this file.
# ftp or sftp. Only the settings of the chosen protocol are needed.
UPLOAD_PROTOCOL="ftp"
REMOTE_DIR="<upload folder on the server>"
FTP_IP="<NAS IP address>"
FTP_USER="<FTP user>"
FTP_PASS="<FTP password>"
SFTP_HOST="<SFTP host>"
SFTP_PORT="22"
SFTP_USER="<SFTP user>"
SFTP_PASS="<SFTP password>"
CAM_IP="<camera IP address>"
CAM_USER="<camera user>"
CAM_PASS="<camera password>"
